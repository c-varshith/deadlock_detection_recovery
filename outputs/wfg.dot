digraph WFG {
    graph [label="Wait-For Graph", fontsize=14];
    P0 [label="P0\nAlpha", shape=ellipse, style=filled, fillcolor="#AED6F1"];
    P1 [label="P1\nBeta", shape=ellipse, style=filled, fillcolor="#AED6F1"];
    P2 [label="P2\nGamma", shape=ellipse, style=filled, fillcolor="#AED6F1"];
    P2 -> P0;
}
